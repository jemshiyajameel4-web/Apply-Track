# Backend Settings
# For local MySQL: mysql+pymysql://username:password@localhost:3306/applytrack
# For SQLite development fallback: sqlite:///./applytrack.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/applytrack
SECRET_KEY=your_secure_random_jwt_secret_key_min_32_characters_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
